{
  "name": "best-boat-auction",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @bba/web dev",
    "build": "turbo run build",
    "build:cloudflare": "pnpm --filter @bba/web build:cloudflare",
    "preview:cloudflare": "pnpm --filter @bba/web preview:cloudflare",
    "deploy:cloudflare": "pnpm --filter @bba/web deploy:cloudflare",
    "start": "pnpm --filter @bba/web start",
    "lint": "turbo run lint && pnpm check:design",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @bba/web test:e2e",
    "test:visual": "pnpm --filter @bba/web test:visual",
    "test:visual:update": "pnpm --filter @bba/web test:visual:update",
    "check:design": "node --experimental-strip-types scripts/check-design-tokens.mts",
    "import:lot-photos": "node apps/web/scripts/import-lot-photos.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
