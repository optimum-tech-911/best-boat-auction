# Public site origin used in sharing previews. Local preview defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Frontend demo runs without credentials. Populate integrations only when implemented.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only secrets: never prefix with NEXT_PUBLIC_ or import into client components.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
