{
  "name": "@bba/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/copy-map-worker.mjs && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots=all"
  },
  "dependencies": {
    "@bba/contracts": "workspace:*",
    "@bba/domain": "workspace:*",
    "@bba/i18n": "workspace:*",
    "@bba/sdk": "workspace:*",
    "@bba/ui": "workspace:*",
    "lucide-react": "1.52.0",
    "maplibre-gl": "6.13.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  }
}
